generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("USER")
  accounts      Account[]
  attempts      Attempt[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  expiresAt             DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accessTokenExpiresAt  DateTime?
  idToken               String?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Problem {
  id                 String      @id @default(uuid())
  title              String
  description        String
  requirements       Json        @default("[]")
  constraints        Json        @default("[]")
  createdAt          DateTime    @default(now()) @map("created_at")
  difficulty         Difficulty  @default(MEDIUM)
  extensibilityHooks Json        @default("[]")
  hints              Json        @default("[]")
  sampleSolution     String?
  tags               Json        @default("[]")
  testCases          Json        @default("[]")
  type               ProblemType @default(LLD)
  attempts           Attempt[]

  @@map("problems")
}

model Attempt {
  id         String        @id @default(uuid())
  problemId  String        @map("problem_id")
  learnerId  String        @map("learner_id")
  status     AttemptStatus @default(DRAFT)
  createdAt  DateTime      @default(now()) @map("created_at")
  learner    User          @relation(fields: [learnerId], references: [id])
  problem    Problem       @relation(fields: [problemId], references: [id])
  evaluation Evaluation?
  hintUsages HintUsage[]
  stages     Stage[]

  @@map("attempts")
}

model Stage {
  id          String      @id @default(uuid())
  attemptId   String      @map("attempt_id")
  stageType   StageType   @map("stage_type")
  content     String      @default("")
  status      StageStatus @default(DRAFT)
  submittedAt DateTime?   @map("submitted_at")
  attempt     Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, stageType])
  @@map("stages")
}

model Evaluation {
  id        String   @id @default(uuid())
  attemptId String   @unique @map("attempt_id")
  results   Json
  createdAt DateTime @default(now()) @map("created_at")
  attempt   Attempt  @relation(fields: [attemptId], references: [id])

  @@map("evaluations")
}

model HintUsage {
  id        String   @id @default(uuid())
  attemptId String   @map("attempt_id")
  hintIndex Int      @map("hint_index")
  createdAt DateTime @default(now()) @map("created_at")
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, hintIndex])
  @@map("hint_usages")
}

model Resource {
  id        String             @id @default(uuid())
  slug      String             @unique
  title     String
  content   String
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  pathItems LearningPathItem[]

  @@map("resources")
}

model LearningPath {
  id          String             @id @default(uuid())
  title       String
  description String
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  items       LearningPathItem[]

  @@map("learning_paths")
}

model LearningPathItem {
  id             String       @id @default(uuid())
  learningPathId String       @map("learning_path_id")
  resourceId     String       @map("resource_id")
  order          Int          @default(0)
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  resource       Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, resourceId])
  @@map("learning_path_items")
}

enum StageType {
  REQUIREMENTS
  DESIGN
  EXTENSION
}

enum ProblemType {
  LLD
  HLD
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum StageStatus {
  DRAFT
  SUBMITTED
  EVALUATING
  COMPLETED
  FAILED
}

enum AttemptStatus {
  DRAFT
  SUBMITTED
  EVALUATING
  COMPLETED
  FAILED
}
